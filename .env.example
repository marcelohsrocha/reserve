# =============================================================================
# Sistema de Reservas de Salas – IPI Dourados
# Copie para .env e preencha. NUNCA versione o arquivo .env.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
# Endereço público (do Cloudflare Tunnel). É o que vai dentro dos QR Codes e
# o endereço do webhook do Google. Deve ser https://.
PUBLIC_BASE_URL=https://reservas.suaigreja.org.br

# Banco SQLite. No Docker o arquivo fica no volume ./data.
DATABASE_URL=file:/app/data/reservas.db

# --- Google Agenda -----------------------------------------------------------
# ID da agenda única "Reservas de Salas – IPI Dourados"
# (Configurações da agenda → Integrar agenda → ID da agenda).
GOOGLE_CALENDAR_ID=xxxxxxxxxxxxxxxx@group.calendar.google.com

# Credencial da Service Account: use UMA das duas opções.
# (a) caminho do arquivo JSON montado no container (recomendado):
GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/service-account.json
# (b) ou o JSON inteiro em uma linha:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Segredo aleatório que o Google devolve no header X-Goog-Channel-Token do webhook.
# Gere com: openssl rand -hex 32
GOOGLE_WEBHOOK_TOKEN=troque-por-um-valor-aleatorio

# --- Login com Google (OAuth) -------------------------------------------------
# Cliente OAuth "Aplicativo da Web" (README, seção 1.1). Redirecionamento autorizado:
#   <PUBLIC_BASE_URL>/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=

# Assina o cookie de sessão e cifra os tokens das agendas pessoais.
# Gere com: openssl rand -hex 32   (trocar = todos entram de novo)
SESSION_SECRET=

# E-mails que sempre entram como administradores (separados por vírgula).
ADMIN_EMAILS=pastor@gmail.com,secretaria@gmail.com

# --- Cloudflare --------------------------------------------------------------
# Token do túnel (Zero Trust → Networks → Tunnels → seu túnel → token).
# O Cloudflare Access NÃO é mais usado: o login é feito pelo app.
TUNNEL_TOKEN=

# --- Desenvolvimento ---------------------------------------------------------
# GOOGLE_FAKE=1        # usa agendas em memória (sem Google)
# Sem GOOGLE_OAUTH_CLIENT_ID (e fora de produção), /entrar oferece login simulado.
# JOBS_DISABLED=1
